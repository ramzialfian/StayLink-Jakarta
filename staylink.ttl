#################################################################
#    Object Properties
#################################################################

###  http://example.com/preference#requires
pref:requires rdf:type owl:ObjectProperty ;
              rdfs:domain schema:Person ;
              rdfs:range schema:LodgingBusiness .


#################################################################
#    Data properties
#################################################################

###  http://example.com/preference#budget
pref:budget rdf:type owl:DatatypeProperty ;
            rdfs:domain schema:Person ;
            rdfs:range xsd:string .


###  http://example.com/preference#likes
pref:likes rdf:type owl:DatatypeProperty ;
           rdfs:domain schema:Person ;
           rdfs:range xsd:string .


###  http://example.com/preference#purpose
pref:purpose rdf:type owl:DatatypeProperty ;
             rdfs:domain schema:Person ;
             rdfs:range xsd:string .


###  http://schema.org/name
schema:name rdf:type owl:DatatypeProperty ;
            rdfs:domain schema:LodgingBusiness ,
                        schema:Person ;
            rdfs:range xsd:string .


###  http://schema.org/starRating
schema:starRating rdf:type owl:DatatypeProperty ;
                  rdfs:domain schema:Hotel ;
                  rdfs:range xsd:integer .


###  http://staylink.id/ontology#classification
slj:classification rdf:type owl:DatatypeProperty ;
                   rdfs:domain schema:LodgingBusiness ;
                   rdfs:range xsd:string .


###  http://www.w3.org/2003/01/geo/wgs84_pos#lat
geo:lat rdf:type owl:DatatypeProperty ;
        rdfs:domain schema:LodgingBusiness ;
        rdfs:range xsd:string .


###  http://www.w3.org/2003/01/geo/wgs84_pos#long
geo:long rdf:type owl:DatatypeProperty ;
         rdfs:domain schema:LodgingBusiness ;
         rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://schema.org/Hotel
schema:Hotel rdf:type owl:Class ;
             rdfs:subClassOf schema:LodgingBusiness .


###  http://schema.org/LodgingBusiness
schema:LodgingBusiness rdf:type owl:Class .


###  http://schema.org/Person
schema:Person rdf:type owl:Class .


